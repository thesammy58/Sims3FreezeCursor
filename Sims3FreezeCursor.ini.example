; Sims3FreezeCursor settings.
;
; Optional - rename to Sims3FreezeCursor.ini and put it next to the .asi.
; Without it every setting below uses the default shown, which is what a
; normal install wants. It exists so a problem can be narrowed down one
; piece at a time without needing a custom build.

[Sims3FreezeCursor]

; The MonoScriptHost::ProcessTasks detour that feeds the stall detector.
;   0 = not installed at all; the mod loads but does nothing
;   1 = normal
;   2 = installed but inert - the detour calls straight through and does no
;       work. Stall detection is off. This is a diagnostic control: if a
;       performance problem survives 2 but not 0, it is caused by the
;       function being hooked rather than by anything this mod computes.
;   3 = inert, plus timing. Reports how long the hooked function takes and
;       what share of the wall clock that is. Needs HeartbeatStatsSeconds set.
SimHook=1

; How the hook attaches, as opposed to what it does.
;   0 = rewrite the call site; install nothing if that isn't possible (default)
;   1 = same as 0
;   2 = use the prologue detour instead
; Rewriting the call leaves the target function's own bytes untouched, so other
; mods that locate the same function by scanning for its prologue still find it.
; There is no automatic fallback to 2: one game build became unplayable under
; the prologue detour and the reason was never found, so it is opt-in only.
HookMethod=0

; The WM_SETCURSOR subclass that swaps in the busy cursor during a stall.
CursorHook=1

; Writes a detailed register/stack dump to the log on an access violation
; anywhere in the process. This is a debugging aid, not a feature: while it
; is on, EVERY exception raised in the process - including the many the game
; raises and handles by itself - is routed out to this mod before the game's
; own handler runs. Turn it on only when asked for a crash log.
CrashCapture=0

; Seconds between sim-pump throughput lines in the log. 0 is off.
; Set to 30 when reporting stutter: the watchdog otherwise only logs state
; changes, so a game running badly while the sim keeps up logs nothing.
HeartbeatStatsSeconds=0
